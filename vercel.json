{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {"api/account/realtime/events.ts": {"maxDuration": 300}, "api/xerogram.py": {"maxDuration": 45}},
  "routes": [
    {"src": "/instagram((?:/.*)?)", "status": 308, "headers": {"Location": "/xerogram$1"}},
    {
      "src": "/xerogram(?:/.*|\\.html)?",
      "headers": {
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https://*.cdninstagram.com https://*.fbcdn.net https://*.fbsbx.com; media-src https://*.cdninstagram.com https://*.fbcdn.net https://*.fbsbx.com; connect-src 'self'; manifest-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; upgrade-insecure-requests",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "dest": "/xerogram.html"
    },
    {
      "src": "/(?:open\\.html|open-launch\\.js|api/open-xerox\\.html)",
      "headers": { "Cache-Control": "no-store" },
      "continue": true
    },
    {
      "src": "/api/open-xerox\\.html",
      "dest": "/open.html"
    },
    {
      "src": "/(?!api(?:/|$)|stream/|360/|edu/|scratch-edu/)(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Content-Security-Policy": "script-src 'self' https://www.youtube.com https://s.ytimg.com https://accounts.google.com; script-src-attr 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/(stream|360|edu|scratch-edu)/([A-Za-z0-9_-]+)",
      "dest": "/api/playback-gateway?route=/$1/$2"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path]"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
